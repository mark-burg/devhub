{
  "name": "devhub",
  "version": "2.0.0",
  "private": true,
  "description": "A static GitHub Pages hub for Allure reports, coverage, benchmarks, API docs and other developer tooling.",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "npm run build && node scripts/serve.mjs dist .devhub-preview",
    "serve": "node scripts/serve.mjs dist .devhub-preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "node scripts/demo.mjs",
    "demo:offline": "node scripts/demo.mjs --no-allure",
    "hub": "node scripts/hub.mjs",
    "list": "node scripts/hub.mjs list --site .devhub-preview"
  },
  "dependencies": {
    "@preact/signals": "^2.11.2",
    "dompurify": "^3.4.16",
    "highlight.js": "^11.12.0",
    "marked": "^18.0.14",
    "mermaid": "^12.0.0",
    "preact": "^10.29.8",
    "vega": "^6.4.0",
    "vega-embed": "^7.3.0",
    "vega-lite": "^6.4.3"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/preact": "^3.2.4",
    "jsdom": "^30.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
